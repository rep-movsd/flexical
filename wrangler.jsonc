{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flexical",
  "main": "./src/server/index.ts",
  // Set to today's date (must be <= the date supported by your local workerd).
  "compatibility_date": "2026-11-24",
  "upload_source_maps": true,
  "assets": {
    // Serve index.html for any unmatched path so client-side routing works.
    "not_found_handling": "single-page-application",
    // Only invoke the Worker for API calls; everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flexical",
      // Replace after `wrangler d1 create flexical`.
      "database_id": "5c96d2cf-3282-4588-bfb1-99dc00fcba03",
      "migrations_dir": "./src/server/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
