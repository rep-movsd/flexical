{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wordtwist",
  "main": "./src/server/index.ts",
  // Set to today's date (must be <= the date supported by your local workerd).
  "compatibility_date": "2026-11-24",
  "upload_source_maps": true,
  "assets": {
    // Serve index.html for any unmatched path so client-side routing works.
    "not_found_handling": "single-page-application",
    // Only invoke the Worker for API calls; everything else is a static asset.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordtwist",
      // Replace after `wrangler d1 create wordtwist`.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
